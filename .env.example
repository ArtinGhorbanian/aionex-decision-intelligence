# Required for real AI answers. Never put this value in JavaScript or commit .env.
OPENAI_API_KEY=

# Safe local defaults: deterministic AI fixtures and no outbound source traffic.
# Set both demo flags to 0 only when you intend to use a configured AI provider.
OMNI_DEMO_MODE=1
OMNI_AI_DEMO_MODE=1
OMNI_OFFLINE_MODE=1
# Legacy alias accepted by the application; prefer OMNI_OFFLINE_MODE.
OMNI_OFFLINE=1
# Demo source traffic and background prediction resolution are separate opt-ins.
OMNI_DEMO_ALLOW_NETWORK=0
OMNI_PREDICTION_NETWORK_ENABLED=0
OMNI_PREDICTION_SWEEPER_ENABLED=0

# Audited cost profile. Different model names safely fall back to these locked
# models; output caps can be reduced but never raised above the values below.
OMNI_ANALYSIS_MODEL=gpt-5-mini
OMNI_CHAT_MODEL=gpt-4o-mini
OMNI_DEEP_DIVE_MODEL=gpt-4o-mini
OMNI_ANALYSIS_MAX_OUTPUT_TOKENS=2600
OMNI_CHAT_MAX_OUTPUT_TOKENS=700
OMNI_DEEP_DIVE_MAX_OUTPUT_TOKENS=1000
# Applies to GPT-5-family models; "low" balances accuracy with reasoning-token cost.
OMNI_REASONING_EFFORT=low
# These are also hard ceilings in the settings schema; lower values are allowed.
OMNI_AI_MAX_QUERY_CHARS=8000
OMNI_AI_MAX_CONTEXT_CHARS=50000
OMNI_AI_MAX_HISTORY_MESSAGES=12
OMNI_AI_TIMEOUT_SECONDS=45
OMNI_AI_MAX_CONCURRENCY=2
OMNI_MAX_ANALYSES_PER_DAY=20
OMNI_MAX_CHAT_MESSAGES_PER_DAY=80
OMNI_MAX_DEEP_DIVES_PER_DAY=40
# Global caps cannot be bypassed by rotating an anonymous browser cookie.
OMNI_GLOBAL_MAX_ANALYSES_PER_DAY=20
OMNI_GLOBAL_MAX_CHAT_MESSAGES_PER_DAY=80
OMNI_GLOBAL_MAX_DEEP_DIVES_PER_DAY=40

# Infrastructure and privacy.
OMNI_DB_PATH=omni.db
OMNI_SESSION_SECRET=
# Optional one-time secret for POST /api/admin/claim-legacy. Leave blank to disable.
OMNI_LEGACY_CLAIM_TOKEN=
OMNI_SECURE_COOKIE=0
# Keep API docs off by default; set to 0 only for local development.
OMNI_DISABLE_DOCS=1
OMNI_RELOAD=0
OMNI_HOST=127.0.0.1
OMNI_PORT=8000
OMNI_MAX_REQUEST_BYTES=128000
OMNI_INTELLIGENCE_CACHE_SECONDS=300
# At most eight locally routed, free/keyless sources are selected per analysis.
OMNI_MAX_SELECTED_FREE_SOURCES=8
# Raw source payloads never enter OpenAI; this is the hard evidence-packet cap.
OMNI_AI_EVIDENCE_MAX_CHARS=4000
OMNI_SOURCE_FETCH_HARD_TIMEOUT_SECONDS=8
# Decoded response bodies above 2 MB are rejected before parsing.
OMNI_SOURCE_MAX_RESPONSE_BYTES=2000000
OMNI_SWEEP_INTERVAL=900
OMNI_HTTP_PROXY=
